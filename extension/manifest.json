{
  "manifest_version": 3,
  "name": "VidRush — Video Downloader",
  "version": "0.2.3",
  "description": "Choose a video quality and download with your local yt-dlp companion.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "webRequest",
    "nativeMessaging",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Download with VidRush",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": ""
}
